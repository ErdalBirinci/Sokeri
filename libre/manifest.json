{
  "manifest_version": 3,
  "name": "Sokeri",
  "version": "1.1.0",
  "description": "Sokeri: sign in with your LibreView account and follow your FreeStyle Libre glucose readings in the browser: live value, trend arrow, chart and threshold alerts.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://*.libreview.io/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sokeri",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
